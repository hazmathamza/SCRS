# Copy this file to .env for local development — NEVER commit a real .env
# On Katabump, set these as environment / startup variables in the panel instead.

DISCORD_TOKEN=put-your-bot-token-here
BOT_PREFIX=-
GUILD_ID=1515858046822252684

# Voice assistant (Groq) — required for /voicejoin and 911 voice dispatch.
# The same Groq key as RetainIQ works. Optional model overrides:
GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=autumn
