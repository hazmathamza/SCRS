# Copy this file to .env for local development — NEVER commit a real .env
# On Katabump, set these as environment / startup variables in the panel instead.

DISCORD_TOKEN=put-your-bot-token-here
BOT_PREFIX=-
GUILD_ID=1515858046822252684

# Voice assistant (Groq) — required for /voicejoin, 911 voice dispatch,
# and the assistant chatbot channel + /ask. The same Groq key as RetainIQ
# works. Optional model overrides:
GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=autumn

# Groq relay (needed on Katabump): Groq's edge blocks Katabump's datacenter
# IPs with 403 "Access denied", so route calls through the Cloudflare Worker
# in groq-relay-worker.js and set both of these:
# GROQ_BASE_URL=https://scrs-groq-relay.<your-subdomain>.workers.dev/openai/v1
# GROQ_RELAY_KEY=<the RELAY_KEY secret you set on the Worker>
